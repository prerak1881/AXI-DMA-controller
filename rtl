//top module connected to the cpu throught the axi_lite interface.
module top(register reg_if,
axi_lite_interface axil_if,
input bit ACLK,APRESETn,
axi_stream_interface axis_if,
axi_interface axi_if
);
localparam ADDR_WIDTH=32;
localparam DATA_WIDTH=32;
localparam MM2S_DMACR=8'h00;
localparam MM2S_DMASR=8'h04;
localparam MM2S_SA=8'h18;
localparam MM2S_LENGTH=8'h28;
wire cmd_valid,cmd_ready,burst_done;//for data mover block
wire[10:0]cmd_bytes;
wire[25:0]total_bytes;
wire[31:0]cmd_addr;
data_mover_block d_m_b(.axi_if(axi_if),
.ACLK(ACLK),
.APRESETn(APRESETn),
.axis_if(axis_if),
.cmd_valid(cmd_valid),
.cmd_bytes(cmd_bytes),
.cmd_addr(cmd_addr),
.total_bytes(total_bytes),
.cmd_ready(cmd_ready),
.burst_done(burst_done)
);// complete the module definitions.
control_logic_fsm ctrl_log(
.ACLK(ACLK),
.reg_if(reg_if),
.APRESETn(APRESETn),
.cmd_valid(cmd_valid),
.cmd_bytes(cmd_bytes),
.cmd_addr(cmd_addr),
.total_bytes(total_bytes),
.cmd_ready(cmd_ready),
.burst_done(burst_done));// same complete the module definitions.
typedef enum logic [1:0] {WR_IDLE,WR_RESPONSE} wr_state_t;
wr_state_t wr_state, wr_next_state;
logic aw_received;
logic w_received;
logic [ADDR_WIDTH-1:0] wr_addr;
logic [DATA_WIDTH-1:0] wr_data;
//states_wr_t state_wr,next_state_wr;
typedef enum logic [1:0]{S0_idle_rd,S1_read_address,S2_read_data}states_rd_t;
states_rd_t state_rd,next_state_rd;
logic[ADDR_WIDTH-1:0]addr_rd;
//fsm for write transafer
// next state assignment sequential block
always_ff @(posedge ACLK or negedge APRESETn) begin
if(!APRESETn)
wr_state<=WR_IDLE;
else
wr_state<=wr_next_state;
end
//fsm working sequential block
always_ff @(posedge ACLK or negedge APRESETn) begin
if(!APRESETn) begin
axil_if.AWREADY <= 1'b0;
axil_if.WREADY  <= 1'b0;
axil_if.BVALID  <= 1'b0;
axil_if.BRESP   <= 2'b00;
aw_received <= 1'b0;
w_received  <= 1'b0;
wr_addr<='0;
wr_data<='0;
end
else begin
case(wr_state)
WR_IDLE: begin
axil_if.AWREADY <= !aw_received;
axil_if.WREADY  <= !w_received;
axil_if.BVALID  <= '0;
if(axil_if.AWVALID) begin
wr_addr <= axil_if.AWADDR;
aw_received <= 1;
end
if(axil_if.WVALID) begin
wr_data <= axil_if.WDATA;
w_received <= 1;
end
end
WR_RESPONSE: begin
if(aw_received && w_received)begin
case(wr_addr[7:0])
MM2S_DMACR:reg_if.MM2S_DMACR<=wr_data;
MM2S_SA:reg_if.MM2S_SA<=wr_data;
MM2S_LENGTH:reg_if.MM2S_LENGTH<=wr_data;
endcase
$display("MM2S_SA = %h", reg_if.MM2S_SA);
$display("MM2S_LENGTH = %h", reg_if.MM2S_LENGTH);
end
axil_if.AWREADY<=1'b0;
axil_if.WREADY<=1'b0;
axil_if.BVALID <= 1'b1;
axil_if.BRESP  <= 2'b00;
if( axil_if.BREADY) begin
aw_received <= 0;
w_received  <= 0;
end
end
endcase
end
end
//next_state assignment
always_comb begin
wr_next_state = wr_state;
case(wr_state)
WR_IDLE: begin
if(aw_received && w_received)
wr_next_state = WR_RESPONSE;
else wr_next_state=WR_IDLE;
end
WR_RESPONSE: begin
if(axil_if.BREADY && axil_if.BVALID)
wr_next_state = WR_IDLE;
end
default:wr_next_state = WR_IDLE;
endcase
end
//fsm for read transfer
// state assignment sequential block
always_ff@(posedge ACLK or negedge APRESETn)begin
if(!APRESETn)
state_rd<=S0_idle_rd;
else
state_rd<=next_state_rd;
end
//fsm working sequential block
always_ff @(posedge ACLK or negedge APRESETn)begin
if(!APRESETn)begin
axil_if.ARREADY<=1'b0;
axil_if.RVALID<=1'b0;
axil_if.RRESP<=2'b00;
end
else begin
case(state_rd)
S0_idle_rd:begin
axil_if.ARREADY<=1'b1;
axil_if.RVALID<=1'b0;
axil_if.RRESP<=2'b00;
if(axil_if.ARVALID)begin
case(axil_if.ARADDR[7:0])
MM2S_DMACR:axil_if.RDATA<=reg_if.MM2S_DMACR;
MM2S_LENGTH:axil_if.RDATA<=reg_if.MM2S_LENGTH;
MM2S_SA:axil_if.RDATA<=reg_if.MM2S_SA;
MM2S_DMASR:axil_if.RDATA<=reg_if.MM2S_DMASR;
endcase
axil_if.RVALID<=1'b1;
axil_if.ARREADY<=1'b0;
axil_if.RRESP<=2'b00;
end
end
S2_read_data:begin
if(axil_if.RREADY )begin
axil_if.RVALID<=1'b0;
end
end
endcase
end
end
//next state assignment combinational block
always_comb begin
next_state_rd=state_rd;
case(state_rd)
S0_idle_rd:
if(axil_if.ARVALID && axil_if.ARREADY)
next_state_rd=S2_read_data;
else next_state_rd=S0_idle_rd;
S2_read_data:if(axil_if.RVALID && axil_if.RREADY)
next_state_rd=S0_idle_rd;
else 
next_state_rd=S2_read_data;
endcase
end
endmodule

