module control_logic_fsm(register reg_if,
input bit ACLK,APRESETn,
output logic cmd_valid,
output logic [10:0]cmd_bytes,
input logic cmd_ready, burst_done,
output logic[31:0]cmd_addr,
output logic[25:0]total_bytes
);
logic[31:0]current_addr,next_4kb_boundary;//,cmd_addr;// deeclaring variables reuired in the fsm logic

logic [10:0]calculated_burst_bytes;
logic [25:0]remaining_bytes;
typedef enum logic [2:0]{S0_idle,S1_calculate,S2_issue_cmd,S3_wait_for_burst,S4_generating_interrupt}states_t;
states_t state, next_state;// state variables decalration for the fsm logic.

always_ff @(posedge ACLK or negedge APRESETn)begin// present state assignement sequential block
if(!APRESETn)begin
state<=S0_idle;
end
else 
state<=next_state;
end

always_ff @(posedge ACLK or negedge APRESETn)begin
if(!APRESETn)begin
reg_if.MM2S_DMASR[1]<=1'b1;//
remaining_bytes<=26'd0;//
calculated_burst_bytes<=11'd0;//
current_addr<=32'd0;//
next_4kb_boundary<=32'd0;//
cmd_valid<=1'b0;//
cmd_bytes<=11'd0;//
total_bytes<=26'd0;//
reg_if.MM2S_DMASR[12]<=1'b0;
cmd_addr<=32'b0;
end

else
case(state)
S0_idle:begin
reg_if.MM2S_DMASR[12]<=1'b0;
if(reg_if.MM2S_DMACR[0]==1'b1)begin
reg_if.MM2S_DMASR[1]<=1'b0;
current_addr<=reg_if.MM2S_SA;
remaining_bytes<=reg_if.MM2S_LENGTH;
total_bytes<=reg_if.MM2S_LENGTH;
next_4kb_boundary<=(((reg_if.MM2S_SA)& 32'hfffff000)+32'h00001000);
end
else 
reg_if.MM2S_DMASR[1]<=1'b1;
end
S1_calculate:begin
calculated_burst_bytes<=(26'd1024<remaining_bytes)?((26'd1024<(next_4kb_boundary-current_addr))?11'd1024:(next_4kb_boundary-current_addr)):((remaining_bytes<(next_4kb_boundary-current_addr))?remaining_bytes:(next_4kb_boundary-current_addr));
end
S2_issue_cmd:begin
cmd_valid<=1'b1;
cmd_bytes<=calculated_burst_bytes;
cmd_addr<=current_addr;
end
S3_wait_for_burst:begin
cmd_valid<=1'b0;
if(burst_done)begin
current_addr<=current_addr+calculated_burst_bytes;
remaining_bytes<=remaining_bytes-calculated_burst_bytes;
next_4kb_boundary<=(((current_addr+calculated_burst_bytes)& 32'hfffff000)+32'h00001000);
end
end
S4_generating_interrupt:begin
reg_if.MM2S_DMASR[12]<=1'b1;
end
endcase
end

always_comb begin// next state assignment procedural block
next_state=state;
case(state)
S0_idle:begin
if (reg_if.MM2S_DMACR[0]==1'b1)
next_state=S1_calculate;
else
next_state=S0_idle;
end
S1_calculate:begin
next_state=S2_issue_cmd;
end
S2_issue_cmd:begin
if(cmd_ready && cmd_valid)
next_state=S3_wait_for_burst;
else
next_state=S2_issue_cmd;
end
S3_wait_for_burst:begin
if(burst_done)
if(remaining_bytes<=calculated_burst_bytes)
next_state=S4_generating_interrupt;
else 
next_state=S1_calculate;
else
next_state=S3_wait_for_burst;
end
S4_generating_interrupt:begin
next_state=S0_idle;
end
endcase
end
endmodule
