module data_mover_block(axi_interface axi_if,
input bit ACLK,APRESETn,
input logic cmd_valid,
input logic[10:0]cmd_bytes,
input logic [31:0] cmd_addr,
input logic[25:0]total_bytes,
output logic cmd_ready,burst_done,
axi_stream_interface axis_if
);
logic [31:0] fifo [255:0];//32 bit data fifo of 256 depth
logic [7:0]rd_ptr,wr_ptr;
logic[8:0]count_fifo;
logic fifo_wr_en,fifo_rd_en,fifo_full,fifo_empty,memory_burst_done;
logic[25:0] byte_count;
typedef enum{S0_idle,S1_address_phase,S2_data_phase}states_t;
states_t next_state,state;
//continuous assignment for stream_interface
assign fifo_empty=(count_fifo==9'd0);
assign fifo_full=(count_fifo==9'd256);
assign axis_if.TVALID=(fifo_empty!=1'b1);
assign axis_if.TDATA=fifo[rd_ptr];
assign fifo_wr_en=(axi_if.RREADY && axi_if.RVALID && !(fifo_full));
assign fifo_rd_en=(axis_if.TVALID && axis_if.TREADY && !(fifo_empty));
always_comb begin
axis_if.TLAST=1'b0;
axis_if.TKEEP=4'b1111;
if( total_bytes-byte_count<26'd4)begin
if(axis_if.TVALID)begin
axis_if.TLAST=1'b1;
end
case(total_bytes[1:0])
2'd0:axis_if.TKEEP=4'b1111;
2'd3:axis_if.TKEEP=4'b0111;
2'd2:axis_if.TKEEP=4'b0011;
2'd1:axis_if.TKEEP=4'b0001;
default:axis_if.TKEEP=4'b1111;
endcase
end
end
always_ff @(posedge ACLK or negedge APRESETn)begin
if(!APRESETn)
state<=S0_idle;
else begin
state<=next_state;
end
end

always_ff @(posedge ACLK or negedge APRESETn)begin
if(!APRESETn)begin
foreach(fifo[i])begin
fifo[i]<=32'b0;
end
{rd_ptr,wr_ptr}<=8'b0;
count_fifo<=9'b0;
byte_count<=26'd0;
cmd_ready<=1'b1;
axi_if.ARADDR<=32'b0;
axi_if.ARLEN<=8'b0;
axi_if.ARSIZE<=3'b010;
axi_if.ARVALID<=1'b0;
axi_if.RREADY<=1'b0;
memory_burst_done<=1'b0;
end

else
case(state)
S0_idle:begin
cmd_ready<=1'b1;
// Defaults every cycle
axi_if.ARVALID <= 1'b0;
axi_if.ARADDR  <= 32'd0;
axi_if.ARLEN   <= 8'd0;
axi_if.ARSIZE  <= 3'b010;
if(cmd_valid)begin
axi_if.ARADDR<=cmd_addr;
$display("[%0t] cmd_valid=%b cmd_bytes=%b cmd_addr=%h",$time, cmd_valid, cmd_bytes, cmd_addr);
axi_if.ARLEN<=((cmd_bytes+3)/4)-1;//there was a bug in this logic.
axi_if.ARSIZE<=3'b010;
axi_if.ARVALID<=1'b1;
memory_burst_done<=1'b0;
end
end
S1_address_phase:begin
cmd_ready<=1'b0;
if(axi_if.ARVALID && axi_if.ARREADY)
axi_if.ARVALID<=1'b0;
end
S2_data_phase:begin
axi_if.RREADY<=!fifo_full;
$display("[%0t] DUT sees TVALID=%0b TREADY=%0b fifo_empty=%0b fifo_rd_en=%0b count=%0d",$time,axis_if.TVALID,axis_if.TREADY,fifo_empty,fifo_rd_en,count_fifo);
if(axi_if.RLAST && fifo_wr_en)begin
memory_burst_done<=1'b1;
end
if(fifo_wr_en)begin
fifo[wr_ptr]<=axi_if.RDATA;
wr_ptr<=wr_ptr+1;
end
if(fifo_rd_en)begin
$display("[%0t] fifo_rd_en byte_count=%0d total=%0d fifo_count=%0d TLAST=%0b",$time,byte_count,total_bytes,count_fifo,axis_if.TLAST);
rd_ptr<=rd_ptr+1;
byte_count<=byte_count+26'd4;
$display("The remaining num of bytes=%d and TVALID is=%b",byte_count,axis_if.TVALID);
end
if(fifo_rd_en && !fifo_wr_en)begin
count_fifo<=count_fifo-1;
end
else if (fifo_wr_en && !fifo_rd_en)begin
count_fifo<=count_fifo+1;
end
else
count_fifo<=count_fifo;
end
endcase
end
//next state conditions 
always_comb begin
next_state=state;
burst_done=1'b0;
case(state)
S0_idle:begin
if(cmd_valid && cmd_ready)
next_state=S1_address_phase;
else
next_state=S0_idle;
end
S1_address_phase:begin
if(axi_if.ARREADY)
next_state=S2_data_phase;
else
next_state=S1_address_phase;
end
S2_data_phase:begin
if(memory_burst_done && fifo_empty )begin
burst_done=1'b1;
next_state=S0_idle;
end
else 
next_state=S2_data_phase;
end
endcase
end
endmodule
